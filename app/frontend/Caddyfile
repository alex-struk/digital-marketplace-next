# One origin: this server answers for every screen and forwards the service's own addresses
# to the backend (decision record 0001). A browser, and the acceptance suite, see one host.
{
	admin off
	auto_https off
	log {
		format json
	}
}

:3000 {
	encode gzip

	handle /api/* {
		reverse_proxy {$BACKEND_ORIGIN:backend:3001}
	}

	# /status is the service's: every request to it runs the deadline hook (decision record 0005).
	# A browser opening it as a page is given the screen instead, which asks the service's /status
	# itself (decision record 0060).
	handle /status {
		@page header Accept *text/html*
		handle @page {
			root * /srv
			rewrite * /index.html
			file_server
		}
		handle {
			reverse_proxy {$BACKEND_ORIGIN:backend:3001}
		}
	}

	# Signing in begins and ends at the service, each with a redirect (decision record 0015).
	handle /auth/* {
		reverse_proxy {$BACKEND_ORIGIN:backend:3001}
	}

	# /admin/email-notification-reference is the service's: it answers the samples to an
	# administrator (R-6.13). A browser opening it as a page is given the screen, which asks the
	# service for them, as /status is (decision record 0067). The page is never kept by a browser,
	# and varies by Accept, so the screen's own request for the samples at this address is never
	# answered with the page from the browser's cache (decision record 0068).
	handle /admin/* {
		header Vary Accept
		@page header Accept *text/html*
		handle @page {
			header Cache-Control no-store
			root * /srv
			rewrite * /index.html
			file_server
		}
		handle {
			reverse_proxy {$BACKEND_ORIGIN:backend:3001}
		}
	}

	# Every other address is a screen. The single-page app's router answers it, and shows
	# the not-found screen for an address it does not know.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
