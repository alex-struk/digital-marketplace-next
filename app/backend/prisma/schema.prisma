// Prisma reads the kept PostgreSQL schema and never migrates it (decision record 0001,
// departure 1). Knex owns the schema's history, in app/migrations.
//
// This file is introspected, not authored: `npm run db:pull --workspace backend` runs
// `prisma db pull` against a migrated database and writes what is there. Slice 2 pulled the
// whole kept schema, because signing in reads and writes `users` and every other table
// refers to it; slice 3 pulled again after adding the three file read-access tables; slice 7
// pulled again after adding the Code With Us attachments and the opportunity state checks;
// slice 8 pulled again after adding the three programs' watcher tables and the view counters;
// slice 9 pulled again after adding the three programs' addenda and the note attachments;
// slice 12 pulled again after adding the organizations' changelog, `affiliationEvents`;
// slice 14 pulled again after adding the Code With Us proposal attachments.
// The names below are Prisma's, not this project's. Nothing here is edited by hand except this
// comment, which a pull replaces and which is put back afterwards.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model content {
  id              String            @id @db.Uuid
  createdAt       DateTime          @db.Timestamptz(6)
  createdBy       String?           @db.Uuid
  slug            String            @unique(map: "content_slug_unique")
  fixed           Boolean           @default(false)
  users           users?            @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "content_createdby_foreign")
  contentVersions contentVersions[]
}

model contentVersions {
  id        Int
  contentId String   @db.Uuid
  title     String
  body      String
  createdAt DateTime @db.Timestamptz(6)
  createdBy String?  @db.Uuid
  content   content  @relation(fields: [contentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "contentversions_contentid_foreign")
  users     users?   @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "contentversions_createdby_foreign")

  @@id([id, contentId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model affiliations {
  id                String              @id @db.Uuid
  createdAt         DateTime            @db.Timestamptz(6)
  updatedAt         DateTime            @db.Timestamptz(6)
  user              String              @db.Uuid
  organization      String              @db.Uuid
  membershipType    String
  membershipStatus  String
  affiliationEvents affiliationEvents[]
  organizations     organizations       @relation(fields: [organization], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "affiliations_organization_foreign")
  users             users               @relation(fields: [user], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "affiliations_user_foreign")
}

